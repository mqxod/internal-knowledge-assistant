# ─────────────────────────────────────────────────────────────────────────────
# Internal Knowledge Assistant — environment configuration
# Copy to .env and fill in. Never commit .env. Server secrets must NOT use the
# NEXT_PUBLIC_ prefix (anything NEXT_PUBLIC_* is shipped to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (Docker/Nginx sets this to 1 automatically)
TRUST_PROXY=0

# ── Database (MongoDB Atlas in production; must be a replica set for transactions)
# Local Docker:  mongodb://localhost:27017/knowledge_assistant?replicaSet=rs0&directConnection=true
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/knowledge_assistant?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/knowledge_assistant?replicaSet=rs0&directConnection=true

# ── Clerk authentication (https://dashboard.clerk.com → API keys) ─────────────
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: PEM public key for networkless token verification (escape newlines as \n)
CLERK_JWT_KEY=
# Optional: comma-separated allowed token origins (azp). Defaults to FRONTEND_URL.
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://localhost:3000
# Comma-separated administrator emails. Choosing "Admin" on the sign-in/sign-up page with one of
# these (verified) emails gives admin access; everyone else is a member. No scripts needed.
ADMIN_EMAILS=admin@yourcompany.com
# Require a verified second factor on the session for admin-only endpoints
REQUIRE_ADMIN_MFA=false

# ── AI provider (Anthropic Claude; https://console.anthropic.com) ─────────────
# anthropic | openai (inferred from the key prefix when unset)
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-xxx
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | none (omit the parameter)
AI_EFFORT=low
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
# Organisation-wide cap on AI calls per UTC month (spend guardrail)
AI_MONTHLY_REQUEST_BUDGET=20000

# ── Vector DB / semantic search (Qdrant) ─────────────────────────────────────
# Docker Compose sets VECTOR_DB_URL=http://qdrant:6333 automatically. Leave unset outside Docker
# for keyword-only search, or point it at a Qdrant instance (e.g. http://localhost:6333).
VECTOR_DB_URL=
# Optional; when set, Qdrant requires it too (docker-compose passes it to the qdrant service).
VECTOR_DB_API_KEY=
VECTOR_COLLECTION=sections
# Embeddings use OpenAI. Defaults to AI_API_KEY when AI_PROVIDER=openai; set this when using Anthropic for answers.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Cosine similarity floor for semantic hits (higher = stricter, fewer "close enough" matches)
VECTOR_MIN_SCORE=0.4
VECTOR_TOP_K=12

# ── Limits ───────────────────────────────────────────────────────────────────
MONTHLY_QUERY_LIMIT=100
MAX_QUESTION_LENGTH=1000
MAX_UPLOAD_SIZE_MB=2
MAX_SECTIONS_PER_DOCUMENT=500
MAX_CHUNK_CHARS=1800
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=12000
MIN_KEYWORD_COVERAGE=0.34
CHAT_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public origin of the web app (used for CORS and Clerk azp checks)
FRONTEND_URL=http://localhost:3000
# Where the Next.js dev server proxies /api/v1 (production uses Nginx instead)
API_URL=http://localhost:4000

# ── Deployment (docker-compose.prod.yml) ─────────────────────────────────────
DOMAIN=
HTTP_PORT=8080
