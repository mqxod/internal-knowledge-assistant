limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
# This server terminates TLS itself, so never trust a client-supplied scheme.
map $scheme $forwarded_proto { default $scheme; }
upstream api_upstream { server api:4000; keepalive 16; }
upstream web_upstream { server web:3000; keepalive 16; }

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    include /etc/nginx/snippets/common.conf;
}

# Reject requests for any other Host header.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}
